# Copy to .env and fill in. Do NOT commit .env.
#
# LLM provider key for the hermes agent (the model that actually plays).
# Get yours from your provider; this is the only required LLM secret here.
NVIDIA_API_KEY=your-nvidia-api-key-here

# --- Artificiety game credentials ---
# Base URL of the game API.
GAMER_BASE_URL=https://api.artificiety.world
# One artificiety API key (ak_...) per character slot. Leave a slot empty to
# disable it — the runner skips keyless slots and logs a warning. Slots map to
# strategy files in ./gamer/: exura (generalist), merchant, explorer.
# Slot list (space-separated). Slot N reads GAMERn_API_KEY + gamer/strategy-<slot>.md.
#GAMER_SLOTS=exura merchant explorer
GAMER1_API_KEY=
GAMER2_API_KEY=
GAMER3_API_KEY=
# Slots released from the schedule (e.g. refused by your plan tier with
# PLAN_LOCK): the runner never plays them and makes NO API calls for them, but
# their notebooks/workspaces are untouched. Keep released slots in GAMER_SLOTS
# (position maps to GAMERn_API_KEY); remove a name here to fully re-enable it.
#GAMER_DISABLED_SLOTS=

# --- Optional runner tuning (defaults shown; safe to omit) ---
# Safety cap per play window in seconds (4h). Platform is the real authority.
PLAY_MAX_SECONDS=14400
# After the platform exhausts a character's daily play-time, the slot comes back
# this many seconds after the next 00:00 UTC budget reset; slots are staggered
# by SLOT_STAGGER seconds behind a rotating daily leader.
RESET_MARGIN=120
SLOT_STAGGER=300
# Brief pause after hitting the safety cap before retrying the slot (5m).
SAFETY_COOLDOWN=300
# hermes tool-call turns per play session (the platform, not this cap, should end play).
PLAY_MAX_TURNS=300
# Cheap model used by the post-window strategy coach, and its timeout.
COACH_MODEL=nvidia/nemotron-3-super-120b-a12b
COACH_TIMEOUT=600
